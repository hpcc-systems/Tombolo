<%- include('partials/layoutStart') %>

<h1 style="margin:0 0 16px;font-size:24px;line-height:32px;color:<%= theme.text %>;">Account Unlocked</h1>

<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:<%= theme.text %>;">
  Your account has been unlocked and you can now sign in.
</p>

<% if (typeof loginLink !== 'undefined' && loginLink) { %>
<div style="margin:0 0 20px;">
  <%- include('partials/button', { href: loginLink, label: 'Sign In', bgColor: theme.success }) %>
</div>
<p style="margin:0 0 20px;font-size:13px;line-height:20px;color:<%= theme.muted %>;word-break:break-all;">
  Direct link: <a href="<%= loginLink %>" style="color:<%= theme.primary %>;"><%= loginLink %></a>
</p>
<% } %>

<p style="margin:0;font-size:14px;line-height:22px;color:<%= theme.danger %>;font-weight:bold;">
  If you did not request this change, contact your administrator immediately.
</p>

<%- include('partials/layoutEnd') %>