<%- include('partials/layoutStart') %>

<h1
  style="
    margin: 0 0 16px;
    font-size: 24px;
    line-height: 32px;
    color: <%= theme.text %>;
  "
>
  Password Expired
</h1>

<p
  style="
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 22px;
    color: <%= theme.text %>;
  "
>
  Your Tombolo password has expired. You will need to contact your
  administration team to reset your password and unlock your account.
</p>

<p
  style="
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 22px;
    color: <%= theme.text %>;
  "
>
  Administration team contact emails:
</p>

<p
  style="
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    color: <%= theme.primary %>;
    word-break: break-all;
  "
>
  <a
    href="<%= typeof contactEmails !== 'undefined' ? contactEmails : '' %>"
    style="color: <%= theme.primary %>"
    ><%= typeof contactEmails !== 'undefined' ? contactEmails.slice(7) : ''
    %></a
  >
</p>

<%- include('partials/layoutEnd') %>
