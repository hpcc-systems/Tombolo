<table role="presentation" cellspacing="0" cellpadding="0" border="0">
  <tr>
    <td bgcolor="<%= bgColor || theme.primary %>" style="border-radius: 6px">
      <a
        href="<%= href %>"
        style="
          display: inline-block;
          padding: 12px 20px;
          color: #ffffff;
          text-decoration: none;
          font-size: 14px;
          font-weight: bold;
          background: <%= bgColor || theme.primary %>;
          border-radius: 6px;
        "
      >
        <%= label %>
      </a>
    </td>
  </tr>
</table>
