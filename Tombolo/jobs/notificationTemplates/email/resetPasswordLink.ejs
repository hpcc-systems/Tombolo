<%- include('partials/layoutStart') %>

<h1 style="margin:0 0 16px;font-size:24px;line-height:32px;color:<%= theme.text %>;">Reset Your Password</h1>

<p style="margin:0 0 16px;font-size:14px;line-height:22px;color:<%= theme.text %>;">
  We received a request to reset your password. Use the button below to continue.
</p>

<% if (typeof passwordRestLink !== 'undefined' && passwordRestLink) { %>
<div style="margin:0 0 20px;">
  <%- include('partials/button', { href: passwordRestLink, label: 'Reset Password', bgColor: theme.primary }) %>
</div>
<p style="margin:0 0 20px;font-size:13px;line-height:20px;color:<%= theme.muted %>;word-break:break-all;">
  Direct link: <a href="<%= passwordRestLink %>" style="color:<%= theme.primary %>;"><%= passwordRestLink %></a>
</p>
<% } %>

<p style="margin:0 0 8px;font-size:14px;line-height:22px;color:<%= theme.text %>;">
  This link will remain valid for <strong><%= validForHours %> hours</strong>.
</p>
<p style="margin:0;font-size:14px;line-height:22px;color:<%= theme.text %>;">
  If you did not request a password reset, please ignore this email.
</p>

<%- include('partials/layoutEnd') %>