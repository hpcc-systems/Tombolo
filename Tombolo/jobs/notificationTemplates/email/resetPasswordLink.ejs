<!-- <%- include('partials/layoutStart') %> -->

<!-- Reset Password Content -->
<div style="text-align:font-family:Arial,Helvetica,sans-serif;">
  
  <h1 style="margin:0 0 30px 0;font-size:24px;font-weight:normal;color:<%= theme.text %>;font-family:Arial,Helvetica,sans-serif;">
    Reset Your Password
  </h1>
  
  <p style="margin:0 0 30px 0;font-size:16px;line-height:1.5;color:<%= theme.text %>;font-family:Arial,Helvetica,sans-serif;">
    We received a request to reset your password.<br>
    Click the button below to create a new password.
  </p>
  
  <% if (typeof passwordRestLink !== 'undefined' && passwordRestLink) { %>
  <div style="margin:0 0 30px 0;">
    <%- include('partials/button', { href: passwordRestLink, label: 'Reset Password', bgColor: theme.primary }) %>
  </div>
  
  <div style="background:<%= theme.bg %>;border-radius:6px;padding:20px;margin:0 0 30px 0;text-align:left;">
    <p style="margin:0 0 10px 0;font-size:14px;font-weight:bold;color:<%= theme.text %>;font-family:Arial,Helvetica,sans-serif;">
      Having trouble with the button?
    </p>
    <p style="margin:0 0 8px 0;font-size:13px;color:<%= theme.muted %>;font-family:Arial,Helvetica,sans-serif;">
      Copy and paste this link into your browser:
    </p>
    <p style="margin:0;font-size:12px;font-family:Arial,Helvetica,sans-serif;word-break:break-all;">
      <a href="<%= passwordRestLink %>" style="color:<%= theme.primary %>;text-decoration:none;">
        <%= passwordRestLink %>
      </a>
    </p>
  </div>
  <% } %>
  
  <div style="background:<%= theme.bg %>;border-left:4px solid <%= theme.primary %>;border-radius:6px;padding:20px;margin:0 0 30px 0;text-align:left;">
    <p style="margin:0 0 8px 0;font-size:14px;font-weight:bold;color:<%= theme.text %>;font-family:Arial,Helvetica,sans-serif;">
      ⏰ This link expires in <%= validForHours %> hours
    </p>
    <p style="margin:0;font-size:13px;color:<%= theme.muted %>;font-family:Arial,Helvetica,sans-serif;">
      For your security, this reset link will only work once.
    </p>
  </div>
  
  <div style="padding:20px 0 0 0;border-top:1px solid <%= theme.border %>;">
    <p style="margin:0;font-size:14px;line-height:1.4;color:<%= theme.muted %>;font-family:Arial,Helvetica,sans-serif;">
      This is an automated message from Tombolo. If you didn't request this password reset, you can safely ignore this email. Your password will remain unchanged.
    </p>
  </div>

</div>

<!-- <%- include('partials/layoutEnd') %> -->